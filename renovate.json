{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Hold the Kubernetes client libraries at the go-1.25 tier: k8s.io/* v0.36 and controller-runtime v0.24 require Go 1.26, but the latest golangci-lint (built with Go 1.25) cannot lint a Go-1.26 target, so CI's Lint job fails. Lift these caps once a Go-1.26 golangci-lint ships.",
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go"
      ],
      "allowedVersions": "<0.36.0"
    },
    {
      "matchPackageNames": [
        "sigs.k8s.io/controller-runtime"
      ],
      "allowedVersions": "<0.24.0"
    },
    {
      "description": "Group minor and patch updates (and digests) into a single PR; majors stay separate for individual review.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "Go modules.",
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "go"
      ]
    },
    {
      "description": "GitHub Actions workflows.",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "description": "Container base image (Dockerfile FROM).",
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "description": "Helm chart and chart image/value references.",
      "matchManagers": [
        "helmv3",
        "helm-values"
      ],
      "addLabels": [
        "helm"
      ]
    }
  ]
}
